# Copy to .env on the server; chmod 600. Never commit filled files.
APP_DOMAIN=
TLS_EMAIL=
APP_ORIGIN=
NEXT_PUBLIC_APP_URL=
POSTGREST_IMAGE=
POSTGREST_SCHEMA=public
POSTGREST_API_KEY=
SCHEMA_USER=jouw_app_user
SCHEMA_ADMIN_USER=jouw_service
POSTGRES_DB=jouw_driver
POSTGRES_PASSWORD=
GATEWAY_DB_ROLE=jouw_gateway
GATEWAY_DB_PASSWORD=
PGRST_DB_URI=
JWT_SECRET=
HASH_SALT_KEY=
RATE_LIMIT_SECRET=
DATA_ENCRYPTION_KEY=
PLATFORM_ADMIN_IDS=
