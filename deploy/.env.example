RESEND_WEBHOOK_SECRET=
MAIL_METADATA_KEY=
PRIVACY_CONTROLLER_NAME=JOUW DRIVER
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
TRIP_RETENTION_YEARS=
CHIRON_TRANSMISSION_ENABLED=false
DEPLOYMENT_MODE=staging
SCHEMA_VALIDATED=false
SCHEMA_SOURCE=independent
