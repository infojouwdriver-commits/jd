{
  email {$TLS_EMAIL}
}
{$APP_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 256KB
  }
  header Strict-Transport-Security "max-age=31536000"
  reverse_proxy app:3000 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
    header_up -Forwarded
  }
}
