# Copy to .env.local. Never commit actual values.
APP_ORIGIN=https://your-domain.example
TRUSTED_ORIGINS=
PLATFORM_ADMIN_IDS=
POSTGREST_URL=https://your-private-database.example
POSTGREST_SCHEMA=your_schema
POSTGREST_API_KEY=
SCHEMA_USER=your_schema_user
SCHEMA_ADMIN_USER=your_schema_admin_user
JWT_SECRET=
HASH_SALT_KEY=
RATE_LIMIT_SECRET=
DATA_ENCRYPTION_KEY=
# Only enable after reverse proxy STRIPS incoming x-real-ip and sets the verified client IP.
TRUST_PROXY=false
RESEND_KEY=
RESEND_FROM_EMAIL=
RESEND_VERIFIED_DOMAIN=
RESEND_FREE_PLAN_CONFIRMED=false
RESEND_WEBHOOK_SECRET=
MAIL_METADATA_KEY=
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
PRIVACY_CONTROLLER_NAME=JOUW DRIVER
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
NEXT_TELEMETRY_DISABLED=1
# Set only after validating the retention basis; precise GPS may require a shorter separate period.
TRIP_RETENTION_YEARS=
# Enable only after acceptance endpoint tests and operational approval.
CHIRON_TRANSMISSION_ENABLED=false
POSTGREST_INTERNAL_NETWORK=false
DEPLOYMENT_MODE=staging
SCHEMA_VALIDATED=false
# Administrator ID -> Base32 TOTP secret, enrolled offline, never a NEXT_PUBLIC value.
ADMIN_TOTP_SECRETS_JSON=
